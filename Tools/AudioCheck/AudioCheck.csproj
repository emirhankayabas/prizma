<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the game's sound recipes outside Unity, measures how loud each clip really is, and
    writes the set out as WAV files to listen to:

      dotnet build -c Release
      dotnet bin/Release/net8.0/AudioCheck.dll measure
      dotnet bin/Release/net8.0/AudioCheck.dll wav <folder>

    Unity's own SDK works: "<Unity>/Editor/Data/DotNetSdk/dotnet.exe".
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Game\SoundSynth.cs" />
    <Compile Include="..\..\Assets\Scripts\Game\SoundMaster.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
